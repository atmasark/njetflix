{
  "name": "njetflix",
  "version": "2.0.0",
  "private": true,
  "description": "(🍿 This isn't Netflix)",
  "license": "ISC",
  "type": "module",
  "workspaces": [
    "api",
    "client"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "concurrently --names api,client --prefix-colors red,cyan \"npm run dev -w api\" \"npm run dev -w client\"",
    "build": "npm run build -w client && npm run build -w api",
    "start": "npm start -w api",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1"
  }
}
